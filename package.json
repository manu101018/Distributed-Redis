{
  "name": "distributed-redis-clone",
  "version": "0.1.0",
  "description": "Phase 1: single-node Redis-compatible KV store (RESP protocol) in TypeScript",
  "main": "dist/src/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/src/server.js",
    "bench": "ts-node-dev --transpile-only benchmark/load-test.ts",
    "bench:build": "node dist/benchmark/load-test.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
